# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="SqFt Quotes <quotes@sqft.dev>"

# Public base URL for /q/<token> links in emails.
# Optional — on Vercel this resolves automatically:
#   preview deployments  -> VERCEL_URL (link to the preview itself)
#   production           -> VERCEL_PROJECT_PRODUCTION_URL (custom domain)
# Set PUBLIC_BASE_URL only to override (ngrok tunnel in dev, custom CDN
# host, etc.).
# PUBLIC_BASE_URL=http://localhost:3000
