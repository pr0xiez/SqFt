# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="SqFt Quotes <quotes@sqft.dev>"

# Public base URL for /q/<token> links in emails.
# Optional — on Vercel this resolves automatically:
#   preview deployments  -> VERCEL_URL (link to the preview itself)
#   production           -> VERCEL_PROJECT_PRODUCTION_URL (custom domain)
# Set PUBLIC_BASE_URL only to override (ngrok tunnel in dev, custom CDN
# host, etc.).
# PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of emails allowed to access /admin/orgs.
# Membership is enforced by lib/auth/superAdmin.ts; changing this requires
# a redeploy. Leave unset in environments that should expose no admin UI.
SUPER_ADMIN_EMAILS=""

# Geoapify address autocomplete (https://www.geoapify.com/). Free tier ~3,000
# req/day. Used server-side by /api/address/autocomplete to power the location
# address form. If unset, the address fields still work as plain manual inputs
# (autocomplete is simply disabled — no dropdown, no error).
GEOAPIFY_API_KEY=
