# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="SqFt Quotes <quotes@sqft.dev>"

# Public base URL for /q/<token> links in emails.
# Optional — on Vercel this resolves automatically:
#   preview deployments  -> VERCEL_URL (link to the preview itself)
#   production           -> VERCEL_PROJECT_PRODUCTION_URL (custom domain)
# Set PUBLIC_BASE_URL only to override (ngrok tunnel in dev, custom CDN
# host, etc.).
# PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of emails allowed to access /admin/orgs.
# Membership is enforced by lib/auth/superAdmin.ts; changing this requires
# a redeploy. Leave unset in environments that should expose no admin UI.
SUPER_ADMIN_EMAILS=""

# Geoapify address autocomplete (https://www.geoapify.com/). Free tier ~3,000
# req/day. Used server-side by /api/address/autocomplete to power the location
# address form. If unset, the address fields still work as plain manual inputs
# (autocomplete is simply disabled — no dropdown, no error).
GEOAPIFY_API_KEY=

# Stripe (rk_test_… in dev/preview, rk_live_… in production)
# Connect onboarding + Checkout return URLs are built from PUBLIC_BASE_URL
# (above) via getPublicBaseUrl() — no separate Stripe base-URL var.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# QuickBooks Online sync (lib/qbo). Unset QBO_ENVIRONMENT hides the
# integration entirely. QBO_ENVIRONMENT: sandbox | production | mock ("mock"
# serves the in-app test realm for the qbo-*.spec.ts Playwright suites and is
# refused in production). Client id/secret come from the Intuit developer
# portal app. QBO_TOKEN_ENC_KEY encrypts OAuth tokens at rest (AES-256-GCM);
# any long random string — losing it orphans every stored connection.
QBO_ENVIRONMENT=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_TOKEN_ENC_KEY=

# Bearer secret for the QBO cron sweeper (/api/qbo/sync/run). Vercel sends
# `Authorization: Bearer $CRON_SECRET` with each cron invocation ONLY when
# this env var is set — leave it unset and every sweep 401s silently, so set
# it anywhere QBO is configured. Any long random string.
CRON_SECRET=
