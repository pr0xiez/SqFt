// SqFt — Flooring Contractor Estimating SaaS
// Multi-tenant: all data is scoped to an Organization

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── TENANCY ─────────────────────────────────────────────────────────────────

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  plan                   String   @default("free") // free | pro
  phone                  String?
  address                String?
  licenseNumber          String?
  logo                   String?
  nextSiteMeasureNumber  Int      @default(1)
  nextEstimateNumber     Int      @default(1)
  timezone               String   @default("America/New_York")
  locale                 String   @default("en-US")
  brandColor             String   @default("#c0341a")
  tagline                String?
  showLicenseOnEstimates Boolean  @default(true)
  defaultDepositPct      Float    @default(0.30)
  defaultValidityDays    Int      @default(21)
  defaultUnitLabel       String   @default("ft²")
  defaultTerms           String   @default("")
  createdAt              DateTime @default(now())

  // ── BILLING (added 2026-05-25) ────────────────────────────────────────────
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("manual")
  // manual | trialing | active | past_due | unpaid | canceled
  trialEndsAt          DateTime?
  currentPeriodEndsAt  DateTime?

  nextInvoiceNumber          Int      @default(1)
  defaultPaymentInstructions String   @default("")
  stripeConnectAccountId     String?

  users             User[]
  invoices          Invoice[]
  customers         Customer[]
  siteMeasures      SiteMeasure[]
  estimates         Estimate[]
  locations         Location[]
  events            Event[]
  crewMembers       CrewMember[]
  lineItemTemplates LineItemTemplate[]
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  password  String // bcrypt hash
  role      String       @default("crew") // admin | lead | crew
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

// ── CORE DATA ────────────────────────────────────────────────────────────────

model Customer {
  id        Int          @id @default(autoincrement())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  source    String       @default("phone") // phone | online | referral | walkin | website
  notes     String?
  createdAt DateTime     @default(now())

  locations Location[]
  events    Event[]

  @@index([orgId])
}

// A physical site address for a customer. A customer can have multiple
// locations (e.g. a primary residence and a rental); each site measure is
// taken at one location, so site measures reach the customer via Location.
model Location {
  id         Int          @id @default(autoincrement())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId Int
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Derived one-line address, composed from the structured parts below via
  // lib/locations/formatAddress on every create. Kept so existing list views
  // and estimate/invoice snapshots that read `address` need no changes.
  address    String
  street     String       @default("")
  unit       String?
  city       String       @default("")
  state      String       @default("")
  postalCode String       @default("")
  lat        Float?
  lon        Float?
  label      String?
  notes      String?
  createdAt  DateTime     @default(now())

  siteMeasures SiteMeasure[]

  @@index([orgId])
  @@index([customerId])
}

model SiteMeasure {
  id                Int          @id @default(autoincrement())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId        Int
  location          Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  title             String       @default("")
  siteMeasureNumber Int?
  date              DateTime     @default(now())
  createdAt         DateTime     @default(now())

  items     SiteMeasureItem[]
  estimates Estimate[]

  @@index([orgId])
}

// A room measurement or a text note inside a site measure
model SiteMeasureItem {
  id            Int         @id @default(autoincrement())
  siteMeasureId Int
  siteMeasure   SiteMeasure @relation(fields: [siteMeasureId], references: [id], onDelete: Cascade)
  type          String // room | note
  sortOrder     Int         @default(0)

  // Room fields
  name  String?
  shape String? // rect | tri
  w     Float?
  l     Float?
  note  String?

  // Note fields
  text String?
}

model Estimate {
  id            Int          @id @default(autoincrement())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteMeasureId Int
  siteMeasure   SiteMeasure  @relation(fields: [siteMeasureId], references: [id], onDelete: Cascade)
  estimateNumber Int
  status        String       @default("draft") // draft | sent | viewed | approved | declined
  date          DateTime     @default(now())
  convenienceFeeRate Float   @default(0.03)
  markupPct     Float        @default(0)
  depositPct    Float        @default(0.50)
  terms         String       @default("")
  validityDays  Int          @default(21)
  approvalToken String?      @unique
  sentAt        DateTime?
  sentToEmail   String?
  sentByEmail   String?
  sentByName    String?
  viewedAt      DateTime?
  approvedAt    DateTime?
  declinedAt    DateTime?
  declineReason String?
  createdAt     DateTime     @default(now())
  /// Denormalized cache of computeEstimateView().total. Null when the estimate
  /// has no line items. Maintained in create/save/revise; backfilled by
  /// scripts/backfillEstimateTotal.ts. Sorting the list by total reads this.
  total         Float?

  lineItems      LineItem[]
  events         Event[]
  approval       EstimateApproval?
  estimateEvents EstimateEvent[]
  invoices       Invoice[]

  // Revision chain — Revise on an accepted/declined estimate clones it
  // into a new draft with this field set to the predecessor's id.
  revisedFromId Int?
  revisedFrom   Estimate?  @relation("EstimateRevisions", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisedBy     Estimate[] @relation("EstimateRevisions")

  @@index([orgId])
}

// A line item (material/labor) in an estimate
model LineItem {
  id            Int      @id @default(autoincrement())
  estimateId    Int
  estimate      Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  rate          Float    @default(0)
  qtyMode       String   @default("manual") // manual | linked_area | linked_perimeter — see lib/utils.ts QtyMode
  qty           Float?
  wastePct      Float    @default(0)
  unitLabel     String   @default("ft²")
  linkedRoomIds Int[] // SiteMeasureItem ids linked to this line item
  sortOrder     Int      @default(0)
}

// Reusable line-item presets, scoped to an Organization. When the user picks
// a template from the LineItemSection dropdown, its name/description/rate/
// unitLabel are copied onto a new LineItem — there is no FK back to the
// template, so editing a template never mutates historical estimates.
model LineItemTemplate {
  id          Int          @id @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rate        Float        @default(0)
  unitLabel   String       @default("ft²")
  archived    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([orgId, archived])
}

// One-click customer approval. Lightweight, append-only record of the
// approval action plus a snapshot of the estimate as the customer saw it.
model EstimateApproval {
  id         Int      @id @default(autoincrement())
  estimateId Int      @unique
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  approvedAt DateTime @default(now())
  ip         String
  userAgent  String
  snapshot   Json
}

model EstimateEvent {
  id         Int      @id @default(autoincrement())
  estimateId Int
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type       String // sent | viewed | accepted | declined | link_rotated | resent | revised_from
  actorEmail String?
  actorName  String?
  ip         String?
  userAgent  String?
  metadata   Json?
  source     String?  // "customer" | "builder" | "system_supersede" — null = legacy
  createdAt  DateTime @default(now())

  @@index([estimateId, createdAt])
}

model Invoice {
  id            Int          @id @default(autoincrement())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  estimateId    Int
  estimate      Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  invoiceNumber Int

  status        String       @default("draft") // draft | sent | viewed | partial | paid | void

  amount        Float
  pct           Float?
  memo          String?

  coverNote           String @default("")
  terms               String @default("")
  paymentInstructions String @default("")

  date          DateTime     @default(now())
  dueDate       DateTime?

  publicToken   String?      @unique
  sentAt        DateTime?
  sentToEmail   String?
  sentByEmail   String?
  sentByName    String?
  viewedAt      DateTime?

  paidAt        DateTime?
  voidedAt      DateTime?

  stripePaymentLinkUrl  String?
  stripePaymentIntentId String? @unique

  snapshot      Json?

  createdAt     DateTime     @default(now())

  payments      Payment[]
  invoiceEvents InvoiceEvent[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([estimateId])
}

model Payment {
  id              Int      @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Float
  method          String   // check | cash | card | ach | stripe | other
  paidAt          DateTime @default(now())
  reference       String?
  note            String?
  recordedByEmail String?
  recordedByName  String?
  stripeChargeId  String?  @unique
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceEvent {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type       String   // sent | viewed | resent | link_rotated | payment_recorded | voided
  actorEmail String?
  actorName  String?
  ip         String?
  userAgent  String?
  metadata   Json?
  source     String?  // customer | builder | system
  createdAt  DateTime @default(now())

  @@index([invoiceId, createdAt])
}

// Calendar events: job installations, measurement visits, etc.
model Event {
  id          Int          @id @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type        String // job | visit | other
  title       String
  customerId  Int?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  estimateId  Int?
  estimate    Estimate?    @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  date        DateTime
  endDate     DateTime?
  startTime   String // "08:00"
  endTime     String // "17:00"
  notes       String?
  createdAt   DateTime     @default(now())
  crewMembers CrewMember[]
}

model CrewMember {
  id        Int          @id @default(autoincrement())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  role      String       @default("")
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())

  events Event[]

  @@index([orgId, archived])
}
