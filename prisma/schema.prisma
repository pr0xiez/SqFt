// SqFt — Flooring Contractor Estimating SaaS
// Multi-tenant: all data is scoped to an Organization

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── TENANCY ─────────────────────────────────────────────────────────────────

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  plan               String   @default("free") // free | pro
  phone              String?
  address            String?
  licenseNumber      String?
  logo               String?
  nextEstimateNumber Int      @default(1)
  nextQuoteNumber    Int      @default(1)
  timezone           String   @default("America/New_York")
  locale             String   @default("en-US")
  brandColor         String   @default("#c0341a")
  tagline            String?
  showLicenseOnQuotes Boolean @default(true)
  defaultDepositPct  Float    @default(0.30)
  defaultValidityDays Int     @default(21)
  defaultUnitLabel   String   @default("ft²")
  defaultTerms       String   @default("")
  createdAt          DateTime @default(now())

  users             User[]
  customers         Customer[]
  estimates         Estimate[]
  quotes            Quote[]
  events            Event[]
  crewMembers       CrewMember[]
  lineItemTemplates LineItemTemplate[]
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  password  String // bcrypt hash
  role      String       @default("crew") // admin | lead | crew
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

// ── CORE DATA ────────────────────────────────────────────────────────────────

model Customer {
  id        Int          @id @default(autoincrement())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  source    String       @default("phone") // phone | online | referral | walkin | website
  notes     String?
  createdAt DateTime     @default(now())

  estimates Estimate[]
  events    Event[]
}

model Estimate {
  id             Int          @id @default(autoincrement())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId     Int
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title          String       @default("")
  estimateNumber Int?
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())

  items  EstimateItem[]
  quotes Quote[]
}

// A room measurement or a text note inside an estimate
model EstimateItem {
  id         Int      @id @default(autoincrement())
  estimateId Int
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type       String // room | note
  sortOrder  Int      @default(0)

  // Room fields
  name  String?
  shape String? // rect | tri
  w     Float?
  l     Float?
  note  String?

  // Note fields
  text String?
}

model Quote {
  id            Int          @id @default(autoincrement())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  estimateId    Int
  estimate      Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  quoteNumber   Int
  status        String       @default("draft") // draft | sent | viewed | accepted | declined
  date          DateTime     @default(now())
  convenienceFeeRate Float   @default(0.03)
  markupPct     Float        @default(0)
  depositPct    Float        @default(0.50)
  terms         String       @default("")
  validityDays  Int          @default(21)
  approvalToken String?      @unique
  sentAt        DateTime?
  sentToEmail   String?
  sentByEmail   String?
  sentByName    String?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  declineReason String?
  createdAt     DateTime     @default(now())

  lineItems LineItem[]
  events    Event[]
  signature QuoteSignature?
  quoteEvents QuoteEvent[]

  // Revision chain — Revise on an accepted/declined quote clones it
  // into a new draft with this field set to the predecessor's id.
  revisedFromId Int?
  revisedFrom   Quote?  @relation("QuoteRevisions", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisedBy     Quote[] @relation("QuoteRevisions")
}

// A line item (material/labor) in a quote
model LineItem {
  id            Int     @id @default(autoincrement())
  quoteId       Int
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  rate          Float   @default(0)
  qtyMode       String  @default("manual") // manual | linked_area | linked_perimeter — see lib/utils.ts QtyMode
  qty           Float?
  wastePct      Float   @default(0)
  unitLabel     String  @default("ft²")
  linkedRoomIds Int[] // EstimateItem ids linked to this line item
  sortOrder     Int     @default(0)
}

// Reusable line-item presets, scoped to an Organization. When the user picks
// a template from the LineItemSection dropdown, its name/description/rate/
// unitLabel are copied onto a new LineItem — there is no FK back to the
// template, so editing a template never mutates historical quotes.
model LineItemTemplate {
  id          Int          @id @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rate        Float        @default(0)
  unitLabel   String       @default("ft²")
  archived    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([orgId, archived])
}

model QuoteSignature {
  id              Int      @id @default(autoincrement())
  quoteId         Int      @unique
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  signedByName    String
  signedByEmail   String
  signatureData   String // base64 PNG data URL, ~5-30KB
  signedAt        DateTime @default(now())
  signedIp        String
  signedUserAgent String
  consentText     String
  quoteSnapshot   Json
  snapshotHash    String
}

model QuoteEvent {
  id         Int      @id @default(autoincrement())
  quoteId    Int
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type       String // sent | viewed | accepted | declined | link_rotated | resent | revised_from
  actorEmail String?
  actorName  String?
  ip         String?
  userAgent  String?
  metadata   Json?
  source     String?  // "customer" | "builder" | "system_supersede" — null = legacy
  createdAt  DateTime @default(now())

  @@index([quoteId, createdAt])
}

// Calendar events: job installations, measurement visits, etc.
model Event {
  id          Int          @id @default(autoincrement())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type        String // job | visit | other
  title       String
  customerId  Int?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId     Int?
  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  date        DateTime
  endDate     DateTime?
  startTime   String // "08:00"
  endTime     String // "17:00"
  notes       String?
  createdAt   DateTime     @default(now())
  crewMembers CrewMember[]
}

model CrewMember {
  id        Int          @id @default(autoincrement())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  role      String       @default("")
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())

  events Event[]

  @@index([orgId, archived])
}
