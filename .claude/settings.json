{
  "permissions": {
    "allow": [
      "Bash(npx biome ci*)",
      "Bash(npx vitest run*)",
      "Bash(npx tsc --noEmit*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run build",
            "timeout": 120,
            "statusMessage": "Verifying build..."
          }
        ]
      }
    ]
  }
}
